# Copy to .env.aws locally. Deploy scripts upload it to the EC2 host as .env.
# Never commit real keys. For Free Tier demos, deploy also forces EMBEDDING_BACKEND=hash.

GEMINI_API_KEY=your_gemini_api_key_here

LLM_PROVIDER=gemini
LLM_RESEARCH_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite
OLLAMA_FALLBACK=false

EMBEDDING_BACKEND=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Compose overrides these to Docker service hostnames on the EC2 host.
DATABASE_URL=postgresql+asyncpg://research:research@postgres:5432/research
DATABASE_URL_SYNC=postgresql+psycopg://research:research@postgres:5432/research
REDIS_URL=redis://redis:6379/0

SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=

HF_HOME=/models
INGEST_QUEUE=ingest_jobs
UPLOAD_DIR=/data/uploads
SEED_DIR=/data/seed
EVAL_PATH=/data/eval/questions.jsonl

CORS_ORIGINS=*
LOG_LEVEL=INFO

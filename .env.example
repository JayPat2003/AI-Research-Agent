# Google AI Studio — required for Gemini (no credit card)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini | ollama
# gemini = primary cloud model; on 429/quota, auto-falls back to local Ollama
# ollama = use local models only (no Gemini key needed)
LLM_PROVIDER=gemini
LLM_RESEARCH_MODEL=gemini-3.5-flash
LLM_FAST_MODEL=gemini-3.5-flash-lite

# Local Ollama (install from https://ollama.com then: ollama pull qwen2.5:7b && ollama pull llama3.2:latest)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_RESEARCH_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=llama3.2:latest
OLLAMA_FALLBACK=true

# bge | hash  (hash = deterministic test embeddings, no model download)
EMBEDDING_BACKEND=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research
DATABASE_URL_SYNC=postgresql+psycopg://research:research@localhost:5432/research
REDIS_URL=redis://localhost:6379/0

# Optional free Semantic Scholar key (higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Live literature search uses Google Scholar (no key) plus arXiv / Semantic Scholar.
# Optional paid web search fallback (unused by default)
TAVILY_API_KEY=

# Local conda: keep this relative. Docker Compose overrides it to /models.
HF_HOME=./models
INGEST_QUEUE=ingest_jobs
UPLOAD_DIR=../data/uploads
SEED_DIR=../data/seed
EVAL_PATH=../data/eval/questions.jsonl

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

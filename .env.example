# Google AI Studio — required for Gemini (no credit card)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Groq fallback when Gemini quota is exhausted
# https://console.groq.com/keys
GROQ_API_KEY=

# gemini | groq | ollama
LLM_PROVIDER=gemini
LLM_RESEARCH_MODEL=gemini-2.5-flash
LLM_FAST_MODEL=gemini-2.5-flash-lite

# Groq fallback models (used when LLM_PROVIDER=groq)
GROQ_RESEARCH_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# bge | hash  (hash = deterministic test embeddings, no model download)
EMBEDDING_BACKEND=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research
DATABASE_URL_SYNC=postgresql+psycopg://research:research@localhost:5432/research
REDIS_URL=redis://localhost:6379/0

# Optional free Semantic Scholar key (higher rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Optional paid web search (DuckDuckGo is the default, no key needed)
TAVILY_API_KEY=

# Local conda: keep this relative. Docker Compose overrides it to /models.
HF_HOME=./models
INGEST_QUEUE=ingest_jobs
UPLOAD_DIR=../data/uploads
SEED_DIR=../data/seed
EVAL_PATH=../data/eval/questions.jsonl

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Default = Free Tier friendly. For full BGE quality use terraform.tfvars.paid.example.
aws_region      = "us-east-1"
project_name    = "ai-research-agent"
instance_type   = "t3.micro"
root_volume_gb  = 30
enable_swap_gb  = 2

ssh_cidr        = "0.0.0.0/0"
app_cidr        = "0.0.0.0/0"
key_name        = ""
create_key_pair = true
domain_name     = ""
